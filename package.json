{
  "name": "kitchen-sketch-serverless-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Serverless Telegram bot (Cloudflare Workers) that turns hand-drawn kitchen sketches into 2D wall plans and cabinet layouts using Vision AI",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "webhook:set": "node scripts/telegram-webhook.mjs set",
    "webhook:info": "node scripts/telegram-webhook.mjs info",
    "webhook:delete": "node scripts/telegram-webhook.mjs delete",
    "render:sample": "esbuild scripts/render-sample.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/render-sample.mjs && node node_modules/.cache/render-sample.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
